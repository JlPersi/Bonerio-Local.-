{
  "manifest_version": 3,
  "name": "Bonerío Inside",
  "version": "0.7.1",
  "description": "Bonerío Local entero en un panel al costado de Matriz, abierto en el bono que estás mirando.",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Abrir Bonerío al costado"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://boneriolocal.com.ar/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.xoms.com.ar/*",
        "*://*.bullmarketbrokers.com/*",
        "*://*.primary.com.ar/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "side.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "frame.html"
      ],
      "matches": [
        "*://*.xoms.com.ar/*",
        "*://*.bullmarketbrokers.com/*",
        "*://*.primary.com.ar/*"
      ]
    }
  ]
}