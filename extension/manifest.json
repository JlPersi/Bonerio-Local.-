{
  "manifest_version": 3,
  "name": "Bonerío Inside",
  "version": "1.1.2",
  "description": "Curvas, TIR, duration, sensibilidad, pases CI/24 hs y datos de Bonerío Local en Matriz. Completa la boleta; no envía órdenes.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Mostrar u ocultar Bonerío Inside",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://boneriolocal.com.ar/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.xoms.com.ar/*",
        "https://*.bullmarketbrokers.com/*",
        "https://*.primary.com.ar/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boneriolocal.com.ar/*"
      ],
      "js": [
        "auth.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "frame.html"
      ],
      "matches": [
        "https://*.xoms.com.ar/*",
        "https://*.bullmarketbrokers.com/*",
        "https://*.primary.com.ar/*"
      ]
    }
  ],
  "homepage_url": "https://boneriolocal.com.ar/inside.html"
}