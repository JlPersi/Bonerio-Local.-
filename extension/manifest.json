{
  "manifest_version": 3,
  "name": "Bonerío Inside",
  "version": "0.17.1",
  "description": "TIR, duration, curvas y datos de Bonerío Local adentro de Matriz.",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Mostrar u ocultar Bonerío Inside"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [],
  "host_permissions": [
    "https://boneriolocal.com.ar/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.xoms.com.ar/*",
        "*://*.bullmarketbrokers.com/*",
        "*://*.primary.com.ar/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "frame.html"
      ],
      "matches": [
        "*://*.xoms.com.ar/*",
        "*://*.bullmarketbrokers.com/*",
        "*://*.primary.com.ar/*"
      ]
    }
  ]
}