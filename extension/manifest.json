{
  "manifest_version": 3,
  "name": "Bonerío Inside",
  "version": "0.1.0",
  "description": "TIR, duration y semáforo de curva de Bonerío Local al lado de tu pantalla de Matriz.",
  "icons": { "128": "icon.png" },
  "action": { "default_title": "Bonerío Inside: activar en esta pestaña" },
  "background": { "service_worker": "bg.js" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://boneriolocal.com.ar/*"],
  "content_scripts": [{
    "matches": ["*://*.xoms.com.ar/*", "*://*.bullmarketbrokers.com/*", "*://*.primary.com.ar/*"],
    "js": ["content.js"], "css": ["panel.css"], "run_at": "document_idle"
  }]
}
